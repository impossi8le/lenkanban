# Safe reference only. Copy outside the publication tree as .env.taskboard.
# FIRST INSTALL ONLY. Never replace the existing production env during upgrades.
# See PRODUCTION_STATE.md for the live deployment settings and preservation rules.
# Empty secrets MUST be generated locally before use; never commit filled values.
# Fill with snapshot-<SHA256> from RELEASE_SNAPSHOT.json, or a verified commit SHA.
TASKBOARD_VERSION=
TASKBOARD_APP_PORT=18766
TASKBOARD_SOCKET_PORT=18768
# Compose interpolation inputs (the env_file path is local, never published).
TASKBOARD_ENV_FILE=.env.taskboard
COMPOSE_PROJECT_NAME=taskboard
GIT_COMMIT=unknown
# Dockerfile build ARG default; not forwarded by Compose build.args.
NODE_IMAGE=node:22.22.2-bookworm-slim
# Fixed container/build defaults; Compose/Dockerfile override these values.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
SOCKET_PORT=3556
PGDATA=/var/lib/postgresql/data/pgdata
NEXT_TELEMETRY_DISABLED=1
npm_config_update_notifier=false
npm_config_fund=false
npm_config_audit=false
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
INTERNAL_EMIT_SECRET=
INTERNAL_EMIT_HOST=socket
INTERNAL_EMIT_ALLOW_PRIVATE_NETWORK=true
CRON_SECRET=
TELEMETRY_ENABLED=true
TELEMETRY_HMAC_SECRET=
NEXTAUTH_URL=https://taskboard.example.invalid
APP_URL=https://taskboard.example.invalid
NEXT_PUBLIC_APP_URL=https://taskboard.example.invalid
NEXT_PUBLIC_SOCKET_URL=
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=taskboard@example.invalid
SUPERADMIN_EMAIL=owner@example.invalid
ATTACHMENT_STORAGE=local
ATTACHMENT_LOCAL_DIR=/data/attachments
# Derived inside the package, never point at another project's database/cache.
# Build DATABASE_URL locally from the dedicated POSTGRES_* values and host db.
DATABASE_URL=
# No Redis service is used by this package; do not point at another project.
