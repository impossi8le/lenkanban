    "prisma": "6.19.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
