{
  "name": "kanban-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/patch-react-big-calendar.mjs --verify && next build && node scripts/build-api-observation.mjs",
    "postinstall": "node scripts/patch-react-big-calendar.mjs --apply",
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run prisma:generate && npm run db:seed",
    "socket:dev": "tsx watch src/socket/server.ts",
    "socket:start": "tsx src/socket/server.ts",
    "socket:build": "node scripts/build-socket.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/features",
    "test:mail": "node --test tests/mail/*.test.mjs",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:ui:redesign": "node scripts/qa/build-redesign-fixture.mjs && node scripts/qa/test-redesign-fixture.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.885.0",
