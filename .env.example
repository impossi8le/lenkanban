# Local development only. Copy to .env and replace both secret placeholders.
DATABASE_URL=postgresql://kanban_local:local_only_change_me@127.0.0.1:55432/kanban_local
NEXTAUTH_URL=http://localhost:3555
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
APP_URL=http://localhost:3555
NEXT_PUBLIC_APP_URL=http://localhost:3555
NEXT_PUBLIC_SOCKET_URL=http://localhost:3556
SOCKET_PORT=3556
PORT=3555
# Generate independently from NEXTAUTH_SECRET; shared by web and socket servers.
INTERNAL_EMIT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
INTERNAL_EMIT_HOST=127.0.0.1
LOCAL_AUTH_MODE=open
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Lenkanban Local <noreply@example.invalid>
ATTACHMENT_STORAGE=local
# Replace with a writable absolute path on your computer.
ATTACHMENT_LOCAL_DIR=REPLACE_WITH_ABSOLUTE_LOCAL_DIRECTORY
TELEMETRY_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# Optional integrations remain disabled until explicitly configured.
CRON_SECRET=
TELEMETRY_HMAC_SECRET=
